FAST_DEMO=1
FULL_RESEARCH=0
ATLAS_API_HOST=127.0.0.1
ATLAS_API_PORT=8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
ALLOW_NETWORK_SYNC=0
EIA_API_KEY=
EIA_API_BASE_URL=https://api.eia.gov/v2

# Deploy (VM): origens liberadas no CORS da API (lista separada por vírgula).
# Em produção, inclua a origem real do painel — ex.: o domínio do Vercel.
ATLAS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Domínio da API na VM (usado no Caddyfile); aponte um A record para o IP da VM.
ATLAS_API_DOMAIN=api.seudominio.com
